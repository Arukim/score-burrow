@page "/"

<PageTitle>Score Burrow</PageTitle>

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Caching.Memory
@using ScoreBurrow.Data
@inject ScoreBurrowDbContext DbContext
@inject IMemoryCache MemoryCache
@inject AuthenticationStateProvider AuthenticationStateProvider

<h1>Score Burrow</h1>

<p>Track Heroes of Might and Magic 3 league games, ratings, and results.</p>

<AuthorizeView>
    <Authorized>
        <h2>My leagues</h2>
        @if (myLeagues == null)
        {
            <p><em>Loading...</em></p>
        }
        else if (!myLeagues.Any())
        {
            <div class="alert alert-info" role="alert">
                You are not in a league yet.
                <a href="/leagues" class="alert-link">Browse leagues</a>
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var league in myLeagues)
                {
                    <div class="col-md-6 mb-3">
                        <div class="card h-100">
                            <div class="card-body">
                                <h5 class="card-title">
                                    @league.Name
                                    @if (!league.IsActive)
                                    {
                                        <span class="badge bg-secondary ms-1">Archived</span>
                                    }
                                </h5>
                                @if (!string.IsNullOrWhiteSpace(league.Description))
                                {
                                    <p class="card-text">@league.Description</p>
                                }
                                <a href="@($"/leagues/{league.Id}")" class="btn btn-primary">
                                    View League <span class="oi oi-chevron-right" aria-hidden="true"></span>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-light border" role="alert">
            <a href="/Account/Login?returnUrl=/" class="alert-link">Log in</a> to see your leagues.
        </div>
    </NotAuthorized>
</AuthorizeView>

<div class="d-flex justify-content-between align-items-center mt-2">
    <h2 class="mb-0">Recently active</h2>
    <a href="/leagues">Browse all leagues</a>
</div>

@if (leagues == null)
{
    <p><em>Loading...</em></p>
}
else if (!leagues.Any())
{
    <div class="alert alert-info" role="alert">
        No leagues found.
    </div>
}
else
{
    <div class="row">
        @foreach (var league in leagues)
        {
            <div class="col-md-6 mb-3">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@league.Name</h5>
                        @if (!string.IsNullOrWhiteSpace(league.Description))
                        {
                            <p class="card-text">@league.Description</p>
                        }
                        <div class="mb-2">
                            <small class="text-muted">
                                <span class="oi oi-people" aria-hidden="true"></span> @league.MemberCount members
                                <span class="ms-3 oi oi-grid-three-up" aria-hidden="true"></span> @league.GameCount games
                            </small>
                        </div>
                        @if (league.MostRecentGameDate.HasValue)
                        {
                            <div class="mb-2">
                                <small class="text-muted">
                                    Last game: @league.MostRecentGameDate.Value.ToString("MMM dd, yyyy")
                                </small>
                            </div>
                        }
                        <div class="mb-2">
                            <small class="text-muted">
                                Created: @league.CreatedDate.ToString("MMM dd, yyyy")
                            </small>
                        </div>
                        <a href="@($"/leagues/{league.Id}")" class="btn btn-primary">
                            View League <span class="oi oi-chevron-right" aria-hidden="true"></span>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="row mt-4">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">🎮 Track Scores</h5>
                    <p class="card-text">Keep track of game scores for multiple players and games.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">📊 Calculate Results</h5>
                    <p class="card-text">Automatically calculate winners, rankings, and statistics.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">🏆 View History</h5>
                    <p class="card-text">Review past games and track performance over time.</p>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<LeagueListItem>? leagues;
    private List<LeagueListItem>? myLeagues;

    protected override async Task OnInitializedAsync()
    {
        await LoadLeaguesAsync();
        await LoadMyLeaguesAsync();
    }

    private async Task LoadLeaguesAsync()
    {
        var cacheKey = "home_leagues_top10";

        if (!MemoryCache.TryGetValue(cacheKey, out List<LeagueListItem>? cachedLeagues))
        {
            // Fetch top 10 leagues ordered by most recent game
            var leaguesData = await DbContext.Leagues
                .AsNoTracking()
                .Where(l => l.IsActive)
                .Select(l => new
                {
                    League = l,
                    MemberCount = DbContext.LeagueMemberships.Count(m => m.LeagueId == l.Id),
                    GameCount = DbContext.Games.Count(g => g.LeagueId == l.Id),
                    MostRecentGameDate = DbContext.Games
                        .Where(g => g.LeagueId == l.Id)
                        .OrderByDescending(g => g.StartTime)
                        .Select(g => (DateTime?)g.StartTime)
                        .FirstOrDefault()
                })
                .OrderByDescending(x => x.MostRecentGameDate)
                .Take(10)
                .ToListAsync();

            cachedLeagues = leaguesData.Select(x => new LeagueListItem
            {
                Id = x.League.Id,
                Name = x.League.Name,
                Description = x.League.Description,
                CreatedDate = x.League.CreatedDate,
                MemberCount = x.MemberCount,
                GameCount = x.GameCount,
                MostRecentGameDate = x.MostRecentGameDate
            }).ToList();

            // Cache for 5 minutes
            var cacheOptions = new MemoryCacheEntryOptions()
                .SetAbsoluteExpiration(TimeSpan.FromMinutes(5));

            MemoryCache.Set(cacheKey, cachedLeagues, cacheOptions);
        }

        leagues = cachedLeagues;
    }

    private async Task LoadMyLeaguesAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrEmpty(userId))
        {
            myLeagues = new List<LeagueListItem>();
            return;
        }

        var cacheKey = $"home_my_leagues_{userId}";
        if (!MemoryCache.TryGetValue(cacheKey, out List<LeagueListItem>? cached))
        {
            cached = await DbContext.LeagueMemberships
                .AsNoTracking()
                .Where(m => m.UserId == userId)
                .OrderByDescending(m => m.League.IsActive)
                .ThenBy(m => m.League.Name)
                .Select(m => new LeagueListItem
                {
                    Id = m.League.Id,
                    Name = m.League.Name,
                    Description = m.League.Description,
                    CreatedDate = m.League.CreatedDate,
                    IsActive = m.League.IsActive
                })
                .ToListAsync();

            MemoryCache.Set(cacheKey, cached, new MemoryCacheEntryOptions()
                .SetAbsoluteExpiration(TimeSpan.FromMinutes(5)));
        }

        myLeagues = cached;
    }

    private class LeagueListItem
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public DateTime CreatedDate { get; set; }
        public int MemberCount { get; set; }
        public int GameCount { get; set; }
        public DateTime? MostRecentGameDate { get; set; }
        public bool IsActive { get; set; } = true;
    }
}
