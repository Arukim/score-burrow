@page "/leagues/{LeagueId:guid}/game/create"

<PageTitle>Create New Game</PageTitle>

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using ScoreBurrow.Data
@using ScoreBurrow.Data.Entities
@using ScoreBurrow.Data.Enums
@using ScoreBurrow.Web.Models
@using ScoreBurrow.Web.Services
@inject ScoreBurrowDbContext DbContext
@inject IGameService GameService
@inject ILeagueService LeagueService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<h1>Create New Game</h1>

@if (!canManage)
{
    <div class="alert alert-danger">
        You do not have permission to create games in this league.
    </div>
}
else if (isLoading)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="mb-4">
        <nav aria-label="Game creation progress">
            <ol class="list-group list-group-horizontal">
                <li class="list-group-item @(currentStep == 1 ? "active" : "")">1. Basic Setup</li>
                <li class="list-group-item @(currentStep == 2 ? "active" : "")">2. Color Assignment</li>
                <li class="list-group-item @(currentStep == 3 ? "active" : "")">3. Town Pool</li>
                <li class="list-group-item @(currentStep == 4 ? "active" : "")">4. Town & Gold</li>
                <li class="list-group-item @(currentStep == 5 ? "active" : "")">5. Review</li>
            </ol>
        </nav>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    @if (currentStep == 1)
    {
        <div class="card">
            <div class="card-body">
                <h3>Step 1: Basic Setup</h3>
                <div class="mb-3">
                    <label class="form-label">Map Name</label>
                    <input type="text" class="form-control" @bind="mapName" placeholder="Enter map name" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Number of Players</label>
                    <select class="form-select" @bind="playerCount">
                        <option value="2">2 Players</option>
                        <option value="3">3 Players</option>
                        <option value="4">4 Players</option>
                        <option value="5">5 Players</option>
                        <option value="6">6 Players</option>
                        <option value="7">7 Players</option>
                        <option value="8">8 Players</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Select Players</label>
                    @foreach (var member in availableMembers)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" 
                                   checked="@selectedMembers.Contains(member.Id)"
                                   @onchange="@(() => TogglePlayer(member.Id))" />
                            <label class="form-check-label">
                                @(member.PlayerDisplayName ?? member.PlayerNickname) (Rating: @member.Glicko2Rating.ToString("F0"))
                            </label>
                        </div>
                    }
                </div>
                <button class="btn btn-primary" @onclick="NextStep" disabled="@(!CanProceedFromStep1())">
                    Next <span class="oi oi-chevron-right"></span>
                </button>
            </div>
        </div>
    }
    else if (currentStep == 2)
    {
        <div class="card">
            <div class="card-body">
                <h3>Step 2: Color Assignment</h3>
                
                <!-- Mode Selector -->
                <div class="mb-3">
                    <div class="btn-group" role="group">
                        <input type="radio" class="btn-check" id="randomMode" checked="@(colorMode == ColorAssignmentMode.Random)" @onchange="@(() => { colorMode = ColorAssignmentMode.Random; })" />
                        <label class="btn btn-outline-primary" for="randomMode">
                            <span class="oi oi-random"></span> Random
                        </label>
                        
                        <input type="radio" class="btn-check" id="tradeMode" checked="@(colorMode == ColorAssignmentMode.Trade)" @onchange="@(() => { colorMode = ColorAssignmentMode.Trade; ResetColorTradeCalculator(); })" />
                        <label class="btn btn-outline-primary" for="tradeMode">
                            <span class="oi oi-transfer"></span> Trade
                        </label>
                    </div>
                </div>

                @if (colorMode == ColorAssignmentMode.Random)
                {
                    <!-- Random Mode UI -->
                    <p class="text-muted">Assign player colors. Only the first @playerCount colors are available.</p>
                    <button class="btn btn-secondary mb-3" @onclick="ShuffleColors">
                        <span class="oi oi-random"></span> Shuffle Colors
                    </button>
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Player</th>
                                <th>Color</th>
                                <th>Position</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < playerAssignments.Count; i++)
                            {
                                var assignment = playerAssignments[i];
                                var index = i;
                                <tr>
                                    <td>@assignment.PlayerName</td>
                                    <td>
                                        <select class="form-select" @bind="assignment.PlayerColor">
                                            @for (int c = 0; c < playerCount; c++)
                                            {
                                                var color = (PlayerColor)c;
                                                <option value="@color">@color.ToString()</option>
                                            }
                                        </select>
                                        <div class="mt-1">
                                            <PlayerColorBadge PlayerColor="@assignment.PlayerColor" />
                                        </div>
                                    </td>
                                    <td>@(i + 1)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <!-- Trade Mode UI -->
                    <p class="text-muted">Players trade for color positions. Gold adjustments will carry to Step 4.</p>
                    
                    <div class="row">
                        <!-- Left Panel: Color Assignment -->
                        <div class="col-md-6">
                            <h5>Color Assignment</h5>
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Position</th>
                                        <th>Color</th>
                                        <th>Player</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < playerCount; i++)
                                    {
                                        var colorIndex = i;
                                        var color = (PlayerColor)i;
                                        var assignedPlayer = playerAssignments.FirstOrDefault(p => (int)p.PlayerColor == colorIndex);
                                        <tr>
                                            <td>@(i + 1)</td>
                                            <td>
                                                <PlayerColorBadge PlayerColor="@color" />
                                            </td>
                                            <td>
                                                <select class="form-select" value="@(assignedPlayer?.MembershipId.ToString() ?? "")" @onchange="@((e) => AssignColorToPlayer(colorIndex, e.Value?.ToString()))">
                                                    <option value="">Unassigned</option>
                                                    @foreach (var pa in playerAssignments.OrderBy(p => p.PlayerName))
                                                    {
                                                        <option value="@pa.MembershipId">@pa.PlayerName</option>
                                                    }
                                                </select>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Right Panel: Color Trading Calculator -->
                        <div class="col-md-6">
                            <h5>Color Trading Calculator</h5>
                            @for (int i = 0; i < playerAssignments.Count; i++)
                            {
                                var assignment = playerAssignments[i];
                                var index = i;
                                var isLastRow = i == playerAssignments.Count - 1;
                                <div class="card mb-2">
                                    <div class="card-body py-2">
                                        <div class="row align-items-center">
                                            <div class="col-md-6">
                                                <label class="form-label small mb-1">Player</label>
                                                <select class="form-select form-select-sm" @bind="assignment.ColorCalculatorPlayerId" @bind:after="CalculateColorGoldDistribution">
                                                    <option value="">Select...</option>
                                                    @{
                                                        var selectedAbove = new HashSet<Guid>();
                                                        for (int r = 0; r < index; r++)
                                                        {
                                                            var playerId = playerAssignments[r].ColorCalculatorPlayerId;
                                                            if (playerId.HasValue && playerId.Value != Guid.Empty)
                                                            {
                                                                selectedAbove.Add(playerId.Value);
                                                            }
                                                        }
                                                        
                                                        var sortedPlayers = playerAssignments
                                                            .OrderBy(p => selectedAbove.Contains(p.MembershipId) ? 1 : 0)
                                                            .ThenBy(p => p.PlayerName);
                                                    }
                                                    @foreach (var pa in sortedPlayers)
                                                    {
                                                        var isAlreadySelected = selectedAbove.Contains(pa.MembershipId);
                                                        <option value="@pa.MembershipId">@pa.PlayerName@(isAlreadySelected ? " (selected)" : "")</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label small mb-1">Stake</label>
                                                @if (isLastRow)
                                                {
                                                    <input type="text" class="form-control form-control-sm" value="N/A" readonly />
                                                }
                                                else
                                                {
                                                    <input type="number" class="form-control form-control-sm" @bind="assignment.ColorCalculatorStake" @bind:after="CalculateColorGoldDistribution" />
                                                }
                                            </div>
                                        </div>
                                        <div class="mt-1 small">
                                            <strong>Gold: </strong>
                                            @{
                                                var selectedPlayer = assignment.ColorCalculatorPlayerId.HasValue && assignment.ColorCalculatorPlayerId.Value != Guid.Empty
                                                    ? playerAssignments.FirstOrDefault(p => p.MembershipId == assignment.ColorCalculatorPlayerId.Value)
                                                    : null;
                                                var displayGold = selectedPlayer?.ColorTradeGold ?? 0;
                                            }
                                            <span class="@(displayGold >= 0 ? "text-success" : "text-danger")">
                                                @(displayGold >= 0 ? "+" : "")@displayGold
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            }
                            <div class="alert alert-info py-2 mb-2">
                                <small>
                                    <strong>Total: @ColorCalculatorTotal</strong>
                                    @if (Math.Abs(ColorCalculatorTotal) <= 1)
                                    {
                                        <span class="text-success ms-2">✓</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger ms-2">⚠ Should be 0 or ±1</span>
                                    }
                                </small>
                            </div>
                            @if (HasColorGoldViolation)
                            {
                                <div class="alert alert-danger py-2 mb-2">
                                    <small>⚠ One or more players would go below -10k gold!</small>
                                </div>
                            }
                            <button class="btn btn-success btn-sm w-100" @onclick="CopyColorCalculatorToAssignments" disabled="@HasColorGoldViolation">
                                <span class="oi oi-check"></span> Apply Color Trades
                            </button>
                        </div>
                    </div>
                }

                <div class="mt-3">
                    <button class="btn btn-secondary me-2" @onclick="PreviousStep">
                        <span class="oi oi-chevron-left"></span> Back
                    </button>
                    <button class="btn btn-primary" @onclick="NextStep">
                        Next <span class="oi oi-chevron-right"></span>
                    </button>
                </div>
            </div>
        </div>
    }
    else if (currentStep == 3)
    {
        <div class="card">
            <div class="card-body">
                <h3>Step 3: Town Pool Selection</h3>
                <p class="text-muted">Ban unwanted towns and select @playerCount towns for the trading pool.</p>
                
                <div class="row">
                    <!-- Ban Towns Section -->
                    <div class="col-md-6">
                        <h5>Ban Towns (Optional)</h5>
                        <p class="small text-muted">You can ban up to @GetMaxBannableCount() towns. Banned: @bannedTowns.Count</p>
                        <div style="max-height: 400px; overflow-y: auto;">
                            @foreach (var town in allTowns.OrderBy(t => t.Name))
                            {
                                var isBanned = bannedTowns.Contains(town.Id);
                                var canToggleBan = isBanned || bannedTowns.Count < GetMaxBannableCount();
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" 
                                           checked="@isBanned"
                                           disabled="@(!canToggleBan)"
                                           @onchange="@(() => ToggleBanTown(town.Id))" />
                                    <label class="form-check-label @(isBanned ? "text-muted text-decoration-line-through" : "")">
                                        @town.Name
                                    </label>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Select Towns Section -->
                    <div class="col-md-6">
                        <h5>Select Towns for Trading Pool</h5>
                        <p class="small text-muted">Selected: @selectedTownsPool.Count / @playerCount required</p>
                        
                        <button class="btn btn-primary mb-3 w-100" @onclick="RandomizeTownPool">
                            <span class="oi oi-random"></span> Randomize Town Pool
                        </button>

                        <div style="max-height: 400px; overflow-y: auto;">
                            @foreach (var town in GetAvailableTowns().OrderBy(t => t.Name))
                            {
                                var isSelected = selectedTownsPool.Contains(town.Id);
                                var canToggleSelect = isSelected || selectedTownsPool.Count < playerCount;
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" 
                                           checked="@isSelected"
                                           disabled="@(!canToggleSelect)"
                                           @onchange="@(() => ToggleSelectTown(town.Id))" />
                                    <label class="form-check-label @(isSelected ? "fw-bold text-primary" : "")">
                                        @town.Name
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="mt-3">
                    <button class="btn btn-secondary me-2" @onclick="PreviousStep">
                        <span class="oi oi-chevron-left"></span> Back
                    </button>
                    <button class="btn btn-primary" @onclick="NextStep" disabled="@(!CanProceedFromStep3())">
                        Next <span class="oi oi-chevron-right"></span>
                    </button>
                </div>
            </div>
        </div>
    }
    else if (currentStep == 4)
    {
        <div class="card">
            <div class="card-body">
                <h3>Step 4: Town, Hero & Gold Trading</h3>
                <div class="row">
                    <!-- Left Block: Assignment -->
                    <div class="col-md-6">
                        <h5>Assignment</h5>
                        @for (int i = 0; i < playerAssignments.Count; i++)
                        {
                            var assignment = playerAssignments[i];
                            var index = i;
                            <div class="card mb-3">
                                <div class="card-header">
                                    <strong>@(i + 1). @assignment.PlayerName (@assignment.PlayerColor)</strong>
                                </div>
                                <div class="card-body">
                                    <div class="mb-2">
                                        <label class="form-label">Town</label>
                                        <select class="form-select" @bind="assignment.TownId" @bind:after="@(() => OnTownChanged(index))">
                                            <option value="0">Select Town...</option>
                                            @foreach (var town in GetSelectedTowns())
                                            {
                                                <option value="@town.Id">@town.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label">Hero (Optional)</label>
                                        <select class="form-select" @bind="assignment.HeroId">
                                            <option value="">No Hero</option>
                                            @if (assignment.AvailableHeroes != null)
                                            {
                                                @foreach (var hero in assignment.AvailableHeroes)
                                                {
                                                    <option value="@hero.Id">@hero.Name</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label">Gold</label>
                                        <input type="number" class="form-control" @bind="assignment.NetGold" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Right Block: Calculator -->
                    <div class="col-md-6">
                        <h5>Gold Calculator</h5>
                        
                        @if (HasColorTrades)
                        {
                            <div class="alert alert-info py-2 mb-3">
                                <small><strong>Starting Gold from Color Trades:</strong></small>
                                <div class="mt-1">
                                    @foreach (var pa in playerAssignments.OrderBy(p => p.PlayerName))
                                    {
                                        <div class="small">
                                            <strong>@pa.PlayerName:</strong> 
                                            <span class="@(pa.ColorTradeGold >= 0 ? "text-success" : "text-danger")">
                                                @(pa.ColorTradeGold >= 0 ? "+" : "")@pa.ColorTradeGold
                                            </span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        
                        @for (int i = 0; i < playerAssignments.Count; i++)
                        {
                            var assignment = playerAssignments[i];
                            var index = i;
                            var isLastRow = i == playerAssignments.Count - 1;
                            <div class="card mb-3">
                                <div class="card-header">
                                    <strong>@(i + 1).</strong>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <label class="form-label">Player</label>
                                            <select class="form-select" @bind="assignment.CalculatorPlayerId" @bind:after="CalculateGoldDistribution">
                                                <option value="">Select...</option>
                                                @{
                                                    // Get players already selected in rows above
                                                    var selectedAbove = new HashSet<Guid>();
                                                    for (int r = 0; r < index; r++)
                                                    {
                                                        var playerId = playerAssignments[r].CalculatorPlayerId;
                                                        if (playerId.HasValue && playerId.Value != Guid.Empty)
                                                        {
                                                            selectedAbove.Add(playerId.Value);
                                                        }
                                                    }
                                                    
                                                    // Sort: unselected players first, then selected players
                                                    var sortedPlayers = playerAssignments
                                                        .OrderBy(p => selectedAbove.Contains(p.MembershipId) ? 1 : 0)
                                                        .ThenBy(p => p.PlayerName);
                                                }
                                                @foreach (var pa in sortedPlayers)
                                                {
                                                    var isAlreadySelected = selectedAbove.Contains(pa.MembershipId);
                                                    <option value="@pa.MembershipId">@pa.PlayerName@(isAlreadySelected ? " (selected)" : "")</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Stake</label>
                                            @if (isLastRow)
                                            {
                                                <input type="text" class="form-control" value="N/A" readonly />
                                            }
                                            else
                                            {
                                                <input type="number" class="form-control" @bind="assignment.CalculatorStake" @bind:after="CalculateGoldDistribution" />
                                            }
                                        </div>
                                    </div>
                                    <div class="mt-2 small">
                                        <div>
                                            <strong>Town Trade: </strong>
                                            @{
                                                var selectedPlayer = assignment.CalculatorPlayerId.HasValue && assignment.CalculatorPlayerId.Value != Guid.Empty
                                                    ? playerAssignments.FirstOrDefault(p => p.MembershipId == assignment.CalculatorPlayerId.Value)
                                                    : null;
                                                var townTradeGold = selectedPlayer?.CalculatedGold ?? 0;
                                                var colorGold = selectedPlayer?.ColorTradeGold ?? 0;
                                                var totalGold = colorGold + townTradeGold;
                                            }
                                            <span class="@(townTradeGold >= 0 ? "text-success" : "text-danger")">
                                                @(townTradeGold >= 0 ? "+" : "")@townTradeGold
                                            </span>
                                        </div>
                                        @if (HasColorTrades)
                                        {
                                            <div class="mt-1">
                                                <strong>Total (Color + Town): </strong>
                                                <span class="@(totalGold >= 0 ? "text-success" : "text-danger") @(totalGold < -10000 ? "fw-bold" : "")">
                                                    @(totalGold >= 0 ? "+" : "")@totalGold
                                                    @if (totalGold < -10000)
                                                    {
                                                        <span class="text-danger">⚠</span>
                                                    }
                                                </span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        <div class="alert alert-info">
                            <strong>Total: @CalculatorTotal</strong>
                            @if (Math.Abs(CalculatorTotal) <= 1)
                            {
                                <span class="text-success ms-2">✓</span>
                            }
                            else
                            {
                                <span class="text-danger ms-2">⚠ Total should be 0 or ±1</span>
                            }
                        </div>
                        @if (HasTownGoldViolation)
                        {
                            <div class="alert alert-danger py-2 mb-2">
                                <small>⚠ One or more players would go below -10k gold with cumulative totals!</small>
                            </div>
                        }
                        <button class="btn btn-success w-100" @onclick="CopyCalculatorToAssignments" disabled="@HasTownGoldViolation">
                            <span class="oi oi-copywriting"></span> Copy to Assignments
                        </button>
                    </div>
                </div>
                <div class="mt-3">
                    <button class="btn btn-secondary me-2" @onclick="PreviousStep">
                        <span class="oi oi-chevron-left"></span> Back
                    </button>
                    <button class="btn btn-primary" @onclick="NextStep" disabled="@(!CanProceedFromStep4())">
                        Next <span class="oi oi-chevron-right"></span>
                    </button>
                </div>
            </div>
        </div>
    }
    else if (currentStep == 5)
    {
        <div class="card">
            <div class="card-body">
                <h3>Step 5: Review & Confirm</h3>
                <div class="mb-3">
                    <strong>Map:</strong> @mapName
                </div>
                <h5>Participants</h5>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Pos</th>
                            <th>Player</th>
                            <th>Color</th>
                            <th>Town</th>
                            <th>Hero</th>
                            <th>Gold</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var orderedAssignments = playerAssignments.OrderBy(p => p.PlayerColor).ToList(); }
                        @for (int i = 0; i < orderedAssignments.Count; i++)
                        {
                            var assignment = orderedAssignments[i];
                            <tr>
                                <td>@(i + 1)</td>
                                <td>@assignment.PlayerName</td>
                                <td><PlayerColorBadge PlayerColor="@assignment.PlayerColor" /></td>
                                <td>@assignment.TownName</td>
                                <td>@(assignment.HeroName ?? "None")</td>
                                <td class="@(assignment.NetGold >= 0 ? "text-success" : "text-danger")">
                                    @(assignment.NetGold >= 0 ? "+" : "")@assignment.NetGold
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <button class="btn btn-secondary me-2" @onclick="PreviousStep">
                    <span class="oi oi-chevron-left"></span> Back
                </button>
                <button class="btn btn-success" @onclick="SubmitGame" disabled="@isCreating">
                    @if (isCreating)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    Start Game
                </button>
            </div>
        </div>
    }

    <div class="mt-3">
        <a href="/leagues/@LeagueId" class="btn btn-outline-secondary">Cancel</a>
    </div>
}

@code {
    [Parameter]
    public Guid LeagueId { get; set; }

    private string? userId;
    private bool canManage = false;
    private bool isLoading = true;
    private bool isCreating = false;
    private string? errorMessage;

    private int currentStep = 1;
    private string mapName = "";
    private int playerCount = 4;

    private List<LeagueMembership> availableMembers = new();
    private HashSet<Guid> selectedMembers = new();
    private List<PlayerAssignment> playerAssignments = new();
    private List<Town> allTowns = new();
    private List<Hero> allHeroes = new();
    
    // Town pool selection state
    private HashSet<int> bannedTowns = new();
    private List<int> selectedTownsPool = new();
    
    // Color assignment mode
    private enum ColorAssignmentMode { Random, Trade }
    private ColorAssignmentMode colorMode = ColorAssignmentMode.Random;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        
        if (user.Identity?.IsAuthenticated ?? false)
        {
            userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            
            if (!string.IsNullOrEmpty(userId))
            {
                canManage = await LeagueService.IsAdminOrOwnerAsync(userId, LeagueId);
            }
        }

        if (canManage)
        {
            await LoadDataAsync();
        }

        isLoading = false;
    }

    private async Task LoadDataAsync()
    {
        availableMembers = await DbContext.LeagueMemberships
            .Where(m => m.LeagueId == LeagueId)
            .OrderBy(m => m.PlayerNickname)
            .ToListAsync();

        allTowns = await DbContext.Towns
            .OrderBy(t => t.Name)
            .ToListAsync();

        allHeroes = await DbContext.Heroes
            .Include(h => h.Town)
            .ToListAsync();
    }

    private void TogglePlayer(Guid memberId)
    {
        if (selectedMembers.Contains(memberId))
        {
            selectedMembers.Remove(memberId);
        }
        else if (selectedMembers.Count < playerCount)
        {
            selectedMembers.Add(memberId);
        }
    }

    private bool CanProceedFromStep1()
    {
        return !string.IsNullOrWhiteSpace(mapName) && 
               selectedMembers.Count == playerCount;
    }

    private bool CanProceedFromStep3()
    {
        return selectedTownsPool.Count == playerCount;
    }

    private bool CanProceedFromStep4()
    {
        return playerAssignments.All(p => p.TownId > 0);
    }

    private int GetMaxBannableCount()
    {
        return allTowns.Count - playerCount;
    }

    private List<Town> GetAvailableTowns()
    {
        return allTowns.Where(t => !bannedTowns.Contains(t.Id)).ToList();
    }

    private List<Town> GetSelectedTowns()
    {
        return allTowns.Where(t => selectedTownsPool.Contains(t.Id)).OrderBy(t => t.Name).ToList();
    }

    private void ToggleBanTown(int townId)
    {
        if (bannedTowns.Contains(townId))
        {
            bannedTowns.Remove(townId);
        }
        else if (bannedTowns.Count < GetMaxBannableCount())
        {
            bannedTowns.Add(townId);
            // If this town was selected, remove it from selection
            if (selectedTownsPool.Contains(townId))
            {
                selectedTownsPool.Remove(townId);
            }
        }
    }

    private void ToggleSelectTown(int townId)
    {
        if (selectedTownsPool.Contains(townId))
        {
            selectedTownsPool.Remove(townId);
        }
        else if (selectedTownsPool.Count < playerCount)
        {
            selectedTownsPool.Add(townId);
        }
    }

    private void RandomizeTownPool()
    {
        var availableTowns = GetAvailableTowns();
        var random = new Random();
        selectedTownsPool = availableTowns
            .OrderBy(x => random.Next())
            .Take(playerCount)
            .Select(t => t.Id)
            .ToList();
    }

    private void NextStep()
    {
        if (currentStep == 1 && CanProceedFromStep1())
        {
            // Initialize player assignments with shuffled players
            var shuffledMembers = selectedMembers.OrderBy(x => Guid.NewGuid()).ToList();
            playerAssignments = shuffledMembers.Select((memberId, index) =>
            {
                var member = availableMembers.First(m => m.Id == memberId);
                return new PlayerAssignment
                {
                    MembershipId = memberId,
                    PlayerName = member.PlayerDisplayName ?? member.PlayerNickname,
                    PlayerColor = (PlayerColor)index,
                    Position = index + 1
                };
            }).ToList();
            currentStep = 2;
        }
        else if (currentStep == 2)
        {
            // Update positions based on color
            playerAssignments = playerAssignments
                .OrderBy(p => (int)p.PlayerColor)
                .Select((p, index) => {
                    p.Position = index + 1;
                    return p;
                })
                .ToList();
            currentStep = 3;
        }
        else if (currentStep == 3 && CanProceedFromStep3())
        {
            currentStep = 4;
        }
        else if (currentStep == 4 && CanProceedFromStep4())
        {
            // Prepare review data
            foreach (var assignment in playerAssignments)
            {
                assignment.TownName = allTowns.FirstOrDefault(t => t.Id == assignment.TownId)?.Name ?? "";
                if (assignment.HeroId.HasValue && assignment.HeroId.Value > 0)
                {
                    assignment.HeroName = allHeroes.FirstOrDefault(h => h.Id == assignment.HeroId)?.Name;
                }
            }
            currentStep = 5;
        }
    }

    private void PreviousStep()
    {
        if (currentStep > 1)
        {
            currentStep--;
        }
    }

    private void ShuffleColors()
    {
        var random = new Random();
        var availableColors = Enumerable.Range(0, playerCount).Select(i => (PlayerColor)i).ToList();
        
        foreach (var assignment in playerAssignments)
        {
            var index = random.Next(availableColors.Count);
            assignment.PlayerColor = availableColors[index];
            availableColors.RemoveAt(index);
        }
    }

    private void OnTownChanged(int index)
    {
        var assignment = playerAssignments[index];
        if (assignment.TownId > 0)
        {
            assignment.AvailableHeroes = allHeroes
                .Where(h => h.TownId == assignment.TownId)
                .OrderBy(h => h.Name)
                .ToList();
            assignment.HeroId = null;
        }
        else
        {
            assignment.AvailableHeroes = null;
            assignment.HeroId = null;
        }
    }

    private void RecalculateGold()
    {
        // Reset all gold values
        foreach (var assignment in playerAssignments)
        {
            assignment.NetGold = -assignment.BidAmount;
        }

        // Distribute bids according to rules
        for (int i = 0; i < playerAssignments.Count; i++)
        {
            var bidAmount = playerAssignments[i].BidAmount;
            if (bidAmount > 0)
            {
                var remainingPlayers = playerCount - i - 1;
                if (remainingPlayers > 0)
                {
                    var sharePerPlayer = bidAmount / remainingPlayers;
                    for (int j = i + 1; j < playerAssignments.Count; j++)
                    {
                        playerAssignments[j].NetGold += sharePerPlayer;
                    }
                }
            }
        }
    }

    private async Task SubmitGame()
    {
        if (string.IsNullOrEmpty(userId))
        {
            errorMessage = "User not authenticated.";
            return;
        }

        isCreating = true;
        errorMessage = null;

        try
        {
            var request = new CreateGameRequest
            {
                MapName = mapName,
                Participants = playerAssignments.Select(p => new ParticipantRequest
                {
                    LeagueMembershipId = p.MembershipId,
                    PlayerColor = p.PlayerColor,
                    Position = p.Position,
                    TownId = p.TownId,
                    HeroId = p.HeroId,
                    GoldTrade = p.NetGold
                }).ToList()
            };

            var gameId = await GameService.CreateGameAsync(LeagueId, userId, request);
            NavigationManager.NavigateTo($"/leagues/{LeagueId}/game/{gameId}/manage");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error creating game: {ex.Message}";
            isCreating = false;
        }
    }

    private class PlayerAssignment
    {
        public Guid MembershipId { get; set; }
        public string PlayerName { get; set; } = "";
        public PlayerColor PlayerColor { get; set; }
        public int Position { get; set; }
        public int TownId { get; set; }
        public int? HeroId { get; set; }
        public int BidAmount { get; set; }
        public int NetGold { get; set; }
        public string TownName { get; set; } = "";
        public string? HeroName { get; set; }
        public List<Hero>? AvailableHeroes { get; set; }
        
        // Town trade calculator properties
        public Guid? CalculatorPlayerId { get; set; }
        public int CalculatorStake { get; set; }
        public int CalculatedGold { get; set; }
        
        // Color trade calculator properties
        public Guid? ColorCalculatorPlayerId { get; set; }
        public int ColorCalculatorStake { get; set; }
        public int ColorTradeGold { get; set; }
    }

    private int CalculatorTotal => playerAssignments.Sum(p => p.CalculatedGold);

    private void CalculateGoldDistribution()
    {
        // Reset all calculated gold values
        foreach (var assignment in playerAssignments)
        {
            assignment.CalculatedGold = 0;
        }

        // Calculate distribution for each row
        for (int i = 0; i < playerAssignments.Count; i++)
        {
            var currentRow = playerAssignments[i];
            
            // Skip if no player selected
            if (!currentRow.CalculatorPlayerId.HasValue || currentRow.CalculatorPlayerId == Guid.Empty)
            {
                continue;
            }

            var stake = currentRow.CalculatorStake;
            
            // Find the player who made the stake and deduct it
            var stakingPlayer = playerAssignments.FirstOrDefault(p => p.MembershipId == currentRow.CalculatorPlayerId.Value);
            if (stakingPlayer != null)
            {
                stakingPlayer.CalculatedGold -= stake;

                // Count how many rows below have players selected
                var playersBelow = new List<Guid>();
                for (int j = i + 1; j < playerAssignments.Count; j++)
                {
                    var playerId = playerAssignments[j].CalculatorPlayerId;
                    if (playerId.HasValue && playerId.Value != Guid.Empty)
                    {
                        playersBelow.Add(playerId.Value);
                    }
                }

                // Distribute stake equally to players selected in rows below
                if (playersBelow.Count > 0 && stake > 0)
                {
                    var sharePerPlayer = stake / playersBelow.Count;
                    var remainder = stake % playersBelow.Count;

                    foreach (var playerId in playersBelow)
                    {
                        var playerToReceive = playerAssignments.FirstOrDefault(p => p.MembershipId == playerId);
                        if (playerToReceive != null)
                        {
                            playerToReceive.CalculatedGold += sharePerPlayer;
                            // Distribute remainder to first few players
                            if (remainder > 0)
                            {
                                playerToReceive.CalculatedGold += 1;
                                remainder--;
                            }
                        }
                    }
                }
            }
        }
    }

    private void CopyCalculatorToAssignments()
    {
        foreach (var assignment in playerAssignments)
        {
            assignment.NetGold = assignment.CalculatedGold;
        }
    }

    // Color trading methods
    private int ColorCalculatorTotal => playerAssignments.Sum(p => p.ColorTradeGold);

    private bool HasColorGoldViolation
    {
        get
        {
            const int MinGoldLimit = -10000;
            return playerAssignments.Any(p => p.ColorTradeGold < MinGoldLimit);
        }
    }

    private void ResetColorTradeCalculator()
    {
        foreach (var assignment in playerAssignments)
        {
            assignment.ColorCalculatorPlayerId = null;
            assignment.ColorCalculatorStake = 0;
            assignment.ColorTradeGold = 0;
        }
    }

    private void AssignColorToPlayer(int colorIndex, string? playerIdStr)
    {
        if (string.IsNullOrEmpty(playerIdStr) || !Guid.TryParse(playerIdStr, out var playerId))
        {
            // Unassign - find player with this color and reset
            var currentPlayer = playerAssignments.FirstOrDefault(p => (int)p.PlayerColor == colorIndex);
            if (currentPlayer != null)
            {
                currentPlayer.PlayerColor = PlayerColor.Red; // Temporary assignment
            }
            return;
        }

        var player = playerAssignments.FirstOrDefault(p => p.MembershipId == playerId);
        if (player != null)
        {
            // Check if another player has this color
            var otherPlayer = playerAssignments.FirstOrDefault(p => (int)p.PlayerColor == colorIndex && p.MembershipId != playerId);
            if (otherPlayer != null)
            {
                // Swap colors
                var tempColor = player.PlayerColor;
                player.PlayerColor = otherPlayer.PlayerColor;
                otherPlayer.PlayerColor = tempColor;
            }
            else
            {
                player.PlayerColor = (PlayerColor)colorIndex;
            }
        }
    }

    private void CalculateColorGoldDistribution()
    {
        // Reset all color trade gold values
        foreach (var assignment in playerAssignments)
        {
            assignment.ColorTradeGold = 0;
        }

        // Calculate distribution for each row
        for (int i = 0; i < playerAssignments.Count; i++)
