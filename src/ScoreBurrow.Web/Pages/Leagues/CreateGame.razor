        }
    }

    // Town trading methods
    private bool HasColorTrades => playerAssignments.Any(p => p.ColorTradeGold != 0);

    private bool HasTownGoldViolation
    {
        get
        {
            const int MinGoldLimit = -10000;
            // Check if any player's cumulative gold (color + town) would go below -10k
            return playerAssignments.Any(p => (p.ColorTradeGold + p.CalculatedGold) < MinGoldLimit);
        }
    }
